// Pinos dos LEDs (Vermelho, Azul, Amarelo, Verde)
int ledPins[] = {13, 12, 11, 10}; 

void setup() {
  // Configura os 4 pinos como saída de energia
  for (int i = 0; i < 4; i++) {
    pinMode(ledPins[i], OUTPUT);
  }
}

void loop() {
  // Manda energia contínua para ligar todos os LEDs
  for (int i = 0; i < 4; i++) {
    digitalWrite(ledPins[i], HIGH); 
  }
}
