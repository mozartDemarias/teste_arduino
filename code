#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// Pinos
const int ledPins[] = {9, 8, 7, 6}; // Vermelho, Azul, Amarelo, Verde
const int botPins[] = {5, 4, 3, 2}; // Vermelho, Azul, Amarelo, Verde

// Variáveis do Jogo
int sequencia[100];
int nivel = 0;
int jogadorAtual = 1;

void setup() {
  for (int i = 0; i < 4; i++) {
    pinMode(ledPins[i], OUTPUT);
    pinMode(botPins[i], INPUT_PULLUP);
  }

  // Inicializa o Display OLED
  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) { 
    for(;;); // Se o display falhar, o código para aqui
  }
  
  display.setTextColor(SSD1306_WHITE);
  randomSeed(analogRead(A0)); // Usa ruído do pino A0 vazio para gerar números aleatórios
}

void loop() {
  telaInicial();
  telaVezJogador();
  
  nivel = 0;
  bool perdeu = false;

  // Loop da rodada do jogador atual
  while (!perdeu) {
    sequencia[nivel] = random(0, 4); // Sorteia o próximo passo (0 a 3)
    nivel++;
    
    tocarSequencia();
    perdeu = !lerJogada(); 
  }

  // Quando o jogador perde
  telaFimDeJogo();
  delay(3000);
  
  // Passa para o próximo jogador (1 a 4)
  jogadorAtual++;
  if (jogadorAtual > 4) {
    jogadorAtual = 1;
  }
}

void telaInicial() {
  display.clearDisplay();
  display.setTextSize(1);
  display.setCursor(0, 20);
  display.println(F(" Aperte qualquer"));
  display.println(F(" botao para"));
  display.println(F(" comecar o jogo"));
  display.display();

  // Fica preso aqui até um botão ser pressionado
  bool iniciou = false;
  while (!iniciou) {
    for (int i = 0; i < 4; i++) {
      if (digitalRead(botPins[i]) == LOW) {
        iniciou = true;
        // Pisca o LED do botão pressionado como feedback de início
        digitalWrite(ledPins[i], HIGH);
        while(digitalRead(botPins[i]) == LOW); // Espera soltar o botão
        digitalWrite(ledPins[i], LOW);
        delay(500);
        break;
      }
    }
  }
}

void telaVezJogador() {
  display.clearDisplay();
  display.setTextSize(2);
  display.setCursor(10, 20);
  display.print(F("JOGADOR "));
  display.println(jogadorAtual);
  display.display();
  delay(2000);
}

void telaFimDeJogo() {
  display.clearDisplay();
  display.setTextSize(2);
  display.setCursor(0, 10);
  display.println(F("ERROU!"));
  
  display.setTextSize(1);
  display.setCursor(0, 40);
  display.print(F("Pontos do Jogador "));
  display.print(jogadorAtual);
  display.print(F(": "));
  display.println(nivel - 1);
  display.display();

  // Efeito visual de erro: pisca todos os LEDs rapidamente
  for (int piscadas = 0; piscadas < 3; piscadas++) {
    for (int i = 0; i < 4; i++) digitalWrite(ledPins[i], HIGH);
    delay(150);
    for (int i = 0; i < 4; i++) digitalWrite(ledPins[i], LOW);
    delay(150);
  }
}

void tocarSequencia() {
  for (int i = 0; i < nivel; i++) {
    int pinoCorrente = sequencia[i];
    digitalWrite(ledPins[pinoCorrente], HIGH);
    delay(400);
    digitalWrite(ledPins[pinoCorrente], LOW);
    delay(200);
  }
}

bool lerJogada() {
  for (int i = 0; i < nivel; i++) {
    int botaoPressionado = -1;
    
    // Espera até que um botão seja apertado
    while (botaoPressionado == -1) {
      for (int b = 0; b < 4; b++) {
        if (digitalRead(botPins[b]) == LOW) {
          botaoPressionado = b;
          
          // Feedback de luz enquanto o botão está pressionado
          digitalWrite(ledPins[b], HIGH);
          
          // Espera o jogador soltar o botão para não registrar duas vezes
          while (digitalRead(botPins[b]) == LOW) { delay(10); } 
          
          digitalWrite(ledPins[b], LOW);
          delay(50);
          break;
        }
      }
    }

    // Se apertou o botão errado, retorna falso (perdeu)
    if (botaoPressionado != sequencia[i]) {
      return false; 
    }
  }
  delay(500); // Pausa antes de começar a próxima sequência
  return true; 
}
