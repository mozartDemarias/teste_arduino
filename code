#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// Define o limite máximo de rodadas para 10
#define MAX_LEVEL 10

int ledPins[] = {13, 12, 11, 10}; 
int buttonPins[] = {5, 4, 3, 2};  
int buzzerPin = 8;

int tones[] = {300, 400, 500, 600}; 

int scores[4] = {0, 0, 0, 0};
int currentPlayer = 0;
int gameSequence[MAX_LEVEL];
int currentLevel = 0;

void setup() {
  for (int i = 0; i < 4; i++) {
    pinMode(ledPins[i], OUTPUT);
    pinMode(buttonPins[i], INPUT_PULLUP);
  }
  pinMode(buzzerPin, OUTPUT);
  
  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    for(;;); 
  }
  
  randomSeed(analogRead(A0)); 
  esperarInicio(); 
}

void loop() {
  if (currentPlayer > 3) {
    mostrarVencedor();
    return;
  }

  if (currentLevel == 0) {
    gameSequence[0] = random(0, 4);
    currentLevel = 1;
    atualizarDisplay("PREPARE-SE!");
    delay(1500);
  } else {
    gameSequence[currentLevel - 1] = random(0, 4);
  }
  
  atualizarDisplay("SUA VEZ!");
  playSequence();
  
  if (!readPlayer()) {
    handleElimination();
  } else {
    scores[currentPlayer] = currentLevel;
    
    // Verifica se completou a 10ª rodada
    if (currentLevel == 10) {
      atualizarDisplay("COMPLETOU!");
      tone(buzzerPin, 800); delay(200);
      tone(buzzerPin, 1000); delay(400);
      noTone(buzzerPin);
      delay(2000);
      currentPlayer++;
      currentLevel = 0; 
    } else {
      currentLevel++;
      atualizarDisplay("CORRETO!");
      delay(800);
    }
  }
}

void playSequence() {
  for (int i = 0; i < currentLevel; i++) {
    int color = gameSequence[i];
    digitalWrite(ledPins[color], HIGH);
    tone(buzzerPin, tones[color]);
    delay(400);
    
    digitalWrite(ledPins[color], LOW);
    noTone(buzzerPin);
    delay(200);
  }
}

bool readPlayer() {
  for (int i = 0; i < currentLevel; i++) {
    int expectedColor = gameSequence[i];
    bool pressed = false;
    
    while (!pressed) {
      for (int j = 0; j < 4; j++) {
        if (digitalRead(buttonPins[j]) == LOW) {
          
          digitalWrite(ledPins[j], HIGH); 
          tone(buzzerPin, tones[j]);
          
          // Aguarda o jogador soltar o botão
          while (digitalRead(buttonPins[j]) == LOW) { delay(10); }
          
          digitalWrite(ledPins[j], LOW);
          noTone(buzzerPin);
          
          // ANTI-BOUNCING: Atraso de 150ms para ignorar vibrações mecânicas da mola
          delay(150);
          
          if (j == expectedColor) {
            pressed = true;
            break;
          } else {
            return false; 
          }
        }
      }
      delay(10);
    }
  }
  return true;
}

void handleElimination() {
  tone(buzzerPin, 150); 
  
  for(int i=0; i<3; i++) {
    for(int j=0; j<4; j++) digitalWrite(ledPins[j], HIGH);
    delay(200);
    for(int j=0; j<4; j++) digitalWrite(ledPins[j], LOW);
    delay(200);
  }
  
  noTone(buzzerPin); 
  
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(WHITE);
  display.setCursor(0, 10);
  display.print("JOGADOR "); 
  display.print(currentPlayer + 1);
  display.setCursor(0, 30);
  display.setTextSize(2);
  display.print("ELIMINADO");
  display.display();
  delay(3000);
  
  currentPlayer++;
  currentLevel = 0; 
}

void atualizarDisplay(String statusMsg) {
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(WHITE);
  display.setCursor(0, 0);
  display.print("VEZ DO JOGADOR "); 
  display.print(currentPlayer + 1);
  display.setCursor(0, 20);
  display.setTextSize(2);
  display.print("Pts: "); 
  display.print(scores[currentPlayer]);
  display.setCursor(0, 50);
  display.setTextSize(1);
  display.print(statusMsg);
  display.display();
}

void esperarInicio() {
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(WHITE);
  display.setCursor(30, 0);
  display.print("GENIOS");
  display.setCursor(0, 25);
  display.print("Aperte o botao");
  display.setCursor(0, 40);
  display.setTextSize(2);
  display.print("VERMELHO");
  display.display();

  while(digitalRead(buttonPins[0]) == HIGH) {
    delay(50);
  }
  
  digitalWrite(ledPins[0], HIGH);
  tone(buzzerPin, tones[0]);
  delay(300);
  digitalWrite(ledPins[0], LOW);
  noTone(buzzerPin);
  
  display.clearDisplay();
  display.display();
  delay(1000);
}

void mostrarVencedor() {
  int maxScore = -1;
  int winner = -1;
  bool empate = false;
  
  for(int i = 0; i < 4; i++){
    if(scores[i] > maxScore) { 
      maxScore = scores[i]; 
      winner = i;
      empate = false;
    } else if (scores[i] == maxScore && maxScore > 0) {
      empate = true;
    }
  }
  
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(WHITE);
  display.setCursor(0, 0);
  display.print("FIM DE JOGO!");
  display.setCursor(0, 25);
  display.setTextSize(2);
  
  if (empate || maxScore == 0) {
    display.print("EMPATE!");
  } else {
    display.print("VENCEU: J"); 
    display.print(winner + 1);
  }
  
  display.setTextSize(1);
  display.setCursor(0, 50);
  display.print("Maior Pontuacao: "); 
  display.print(maxScore);
  display.display();
  
  delay(8000);
  
  currentPlayer = 0;
  currentLevel = 0;
  for(int i = 0; i < 4; i++) scores[i] = 0;
  
  esperarInicio(); 
}